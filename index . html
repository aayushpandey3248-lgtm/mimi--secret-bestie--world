</div>
</section>


<!-- MAIN WORLD -->
<section id="world" class="page">
<div class="card">

  <div style="font-size:60px">🎀💗✨</div>

  <h1>Welcome Mimi!</h1>

  <p>
    You officially entered your secret bestie world 🥹
  </p>

  <div class="boxes">

    <div class="box" onclick="openMessage('m1')">
      💌<br><b>Secret Message</b>
    </div>

    <div class="box" onclick="openMessage('m2')">
      🎁<br><b>Surprise Box</b>
    </div>

    <div class="box" onclick="showPage('letter')">
      💌<br><b>Animated Letter</b>
    </div>

    <div class="box" onclick="showPage('timeline')">
      💖<br><b>Our Timeline</b>
    </div>

    <div class="box" onclick="showPage('gallery')">
      📸<br><b>Our Memories</b>
    </div>

    <div class="box" onclick="showPage('game')">
      🧸<br><b>Mini Game</b>
    </div>

  </div>

  <div id="m1" class="message">
    Mimi, you're genuinely one of those people who make ordinary days feel special. 🎀💗
  </div>

  <div id="m2" class="message">
    Surpriseee! You found another secret box! 😂🎁💗
  </div>

  <button class="btn" onclick="showPage('secret')">
    🔐 Secret Surprise
  </button>

  <button class="btn" onclick="showPage('final')">
    🥹 One Last Thing...
  </button>

</div>
</section>


<!-- LETTER -->
<section id="letter" class="page">
<div class="card">

  <h2>💌 A Letter For Mimi</h2>

  <div class="envelope" onclick="openLetter()">
    <span>💌</span>
  </div>

  <p class="small">Tap the envelope 🎀</p>

  <div id="letterBox" class="letter">
    <p id="typedText"></p>
  </div>

  <button class="btn back" onclick="showPage('world')">
    Back 💗
  </button>

</div>
</section>


<!-- TIMELINE -->
<section id="timeline" class="page">
<div class="card">

  <h2>💖 Our Little Timeline</h2>

  <div class="timeline">

    <div class="timeline-item">
      🌷 <b>First Meeting</b><br>
      The beginning of our bestie story.
    </div>

    <div class="timeline-item">
      💗 <b>First Memory</b><br>
      One small moment that became a memory.
    </div>

    <div class="timeline-item">
      😂 <b>Funniest Moment</b><br>
      Certified chaos. No explanation needed. 😭
    </div>

    <div class="timeline-item">
      🎀 <b>Today</b><br>
      And somehow we're still creating memories.
    </div>

  </div>

  <button class="btn back" onclick="showPage('world')">
    Back 💗
  </button>

</div>
</section>


<!-- GALLERY -->
<section id="gallery" class="page">
<div class="card">

  <h2>📸 Our Memories</h2>

  <p>Some memories deserve their own little scrapbook. 🎀</p>

  <div class="gallery">

    <div class="photo-card">
      <div class="photo">
        <!-- Replace with: <img src="photo1.jpg"> -->
        📸
      </div>
      <div class="caption">
        That one unforgettable day 💗
      </div>
    </div>

    <div class="photo-card">
      <div class="photo">
        <!-- Replace with: <img src="photo2.jpg"> -->
        📸
      </div>
      <div class="caption">
        Certified chaos 😂🎀
      </div>
    </div>

    <div class="photo-card">
      <div class="photo">
        <!-- Replace with: <img src="photo3.jpg"> -->
        📸
      </div>
      <div class="caption">
        Bestie moments 🥹
      </div>
    </div>

    <div class="photo-card">
      <div class="photo">
        <!-- Replace with: <img src="photo4.jpg"> -->
        📸
      </div>
      <div class="caption">
        More memories loading... ✨
      </div>
    </div>

  </div>

  <p class="small">
    Photos can be added later by uploading them to the GitHub repository.
  </p>

  <button class="btn back" onclick="showPage('world')">
    Back 💗
  </button>

</div>
</section>


<!-- MINI GAME -->
<section id="game" class="page">
<div class="card">

  <h2>🧸 Catch The Hearts</h2>

  <p>
    Tap the falling hearts before they disappear! 💗
  </p>

  <h3>
    Score: <span id="score">0</span>
  </h3>

  <div id="gameArea"></div>

  <button class="btn" onclick="startGame()">
    Start Game 🎮
  </button>

  <button class="btn back" onclick="showPage('world')">
    Back
  </button>

</div>
</section>


<!-- SECOND PASSWORD -->
<section id="secret" class="page">
<div class="card">

  <div style="font-size:55px">🔐🎀</div>

  <h2>Another Secret?</h2>

  <p>
    Hmm... maybe there is one more hidden surprise 👀
  </p>

  <input
    id="secretPassword"
    class="input"
    placeholder="Special password"
  >

  <button class="btn" onclick="secondUnlock()">
    Open Secret 💗
  </button>

  <p id="secretWrong" style="display:none;color:#e83d72">
    That's not it 👀
  </p>

  <button class="btn back" onclick="showPage('world')">
    Back
  </button>

</div>
</section>


<!-- SECRET RESULT -->
<section id="secretResult" class="page">
<div class="card">

  <div style="font-size:70px">🎁✨</div>

  <h1>You Found It!</h1>

  <p>
    Okay Mimi... you officially discovered the hidden secret. 😂🎀
  </p>

  <p>
    <b>Bestie level: UNLOCKED 💗</b>
  </p>

  <button class="btn" onclick="showPage('final')">
    One Last Thing... 🥹
  </button>

</div>
</section>


<!-- FINAL -->
<section id="final" class="page">
<div class="card">

  <div style="font-size:70px">🥹💗🎀</div>

  <h1>One Last Thing...</h1>

  <p id="finalText">
    Mimi, thank you for being a part of so many little memories.
    Here's to more laughs, more nonsense, more teasing,
    and many more memories together. 🫶🎀
  </p>

  <button class="btn" onclick="celebrate()">
    Open Final Surprise ✨
  </button>

  <div id="finalMessage" style="display:none;margin-top:20px">

    <h2>You're Stuck With Me 😂💗</h2>

    <p>
      No refunds. No exchanges. Bestie contract is permanent. 😭🎀
    </p>

    <p>
      Your bestie,<br>
      <b>Aayush 🫶</b>
    </p>

  </div>

  <button class="btn back" onclick="showPage('world')">
    Back to Secret World
  </button>

</div>
</section>


<script>

/* PAGE SYSTEM */
function showPage(id){

  document.querySelectorAll(".page").forEach(function(page){
    page.classList.remove("active");
  });

  const page=document.getElementById(id);

  if(page){
    page.classList.add("active");
    window.scrollTo(0,0);
  }
}


/* FIRST PASSWORD */
function unlock(){

  const password=
    document.getElementById("password").value.trim();

  if(password==="MIMI🎀"){

    document.getElementById("wrong").style.display="none";

    showPage("world");

    floatingHearts();

  }else{

    document.getElementById("wrong").style.display="block";

  }
}


/* SECOND PASSWORD */
function secondUnlock(){

  const password=
    document.getElementById("secretPassword").value.trim();

  /* Change this password whenever you want */
  if(password==="BESTIE💗"){

    document.getElementById("secretWrong").style.display="none";

    showPage("secretResult");

    floatingHearts();

  }else{

    document.getElementById("secretWrong").style.display="block";

  }
}


/* ENTER KEY */
document.addEventListener("DOMContentLoaded",function(){

  document.getElementById("password")
  .addEventListener("keydown",function(e){

    if(e.key==="Enter"){
      unlock();
    }

  });

  document.getElementById("secretPassword")
  .addEventListener("keydown",function(e){

    if(e.key==="Enter"){
      secondUnlock();
    }

  });

});


/* MESSAGE */
function openMessage(id){

  const message=document.getElementById(id);

  if(message.style.display==="block"){
    message.style.display="none";
  }else{
    message.style.display="block";
  }

}


/* MUSIC */
function toggleMusic(){

  const music=document.getElementById("music");
  const button=document.getElementById("musicBtn");

  if(music.paused){

    music.play();

    button.innerHTML="⏸ Pause";

  }else{

    music.pause();

    button.innerHTML="🎵 Play";

  }

}


/* LETTER */
function openLetter(){

  const box=document.getElementById("letterBox");
  const text=document.getElementById("typedText");

  box.style.display="block";

  text.innerHTML="";

  const letter=
`Dear Mimi 🎀,

Thodi masti, thoda drama,
aur bahut saari memories... 🥹

You're one of those people
who can make a normal day
feel a little more special.

Thank you for all the laughs,
the random moments,
and all the memories.

Here's to many more. 💗

Your bestie,
Aayush 🫶`;

  let i=0;

  function type(){

    if(i<letter.length){

      text.innerHTML+=letter.charAt(i);

      i++;

      setTimeout(type,35);

    }

  }

  type();

}


/* GAME */
let score=0;
let gameTimer;

function startGame(){

  score=0;

  document.getElementById("score").innerText=score;

  const area=document.getElementById("gameArea");

  area.innerHTML="";

  clearInterval(gameTimer);

  gameTimer=setInterval(function(){

    const heart=document.createElement("div");

    heart.className="heartGame";

    heart.innerHTML=
      ["💗","💕","💖","🎀"][Math.floor(Math.random()*4)];

    heart.style.left=
      Math.random()*90+"%";

    heart.onclick=function(){

      score++;

      document.getElementById("score").innerText=score;

      heart.remove();

    };

    area.appendChild(heart);

    setTimeout(function(){

      if(heart.parentNode){
        heart.remove();
      }

    },3000);

  },700);

}


/* FLOATING HEARTS */
function floatingHearts(){

  for(let i=0;i<15;i++){

    setTimeout(function(){

      const heart=document.createElement("div");

      heart.className="float";

      heart.innerHTML=
        ["💗","💕","🎀","✨","🦋"][Math.floor(Math.random()*5)];

      heart.style.left=
        Math.random()*100+"vw";

      heart.style.animationDuration=
        (3+Math.random()*3)+"s";

      document.body.appendChild(heart);

      setTimeout(function(){
        heart.remove();
      },6000);

    },i*150);

  }

}


/* FINAL CONFETTI */
function celebrate(){

  document.getElementById("finalMessage").style.display="block";

  for(let i=0;i<60;i++){

    setTimeout(function(){

      const c=document.createElement("div");

      c.className="confetti";

      c.innerHTML=
        ["💗","🎀","✨","💕","🌷","🦋"][Math.floor(Math.random()*6)];

      c.style.left=
        Math.random()*100+"vw";

      c.style.animationDuration=
        (2+Math.random()*2)+"s";

      document.body.appendChild(c);

      setTimeout(function(){
        c.remove();
      },4500);

    },i*35);

  }

}

</script>

</body>
</html>
    
  
