<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mimi 🎀 | Secret Bestie World</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Poppins", Arial, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #ffd6e7, #f8c8dc, #e8c7ff);
      color: #5c3150;
      overflow-x: hidden;
    }

    button {
      font-family: inherit;
      cursor: pointer;
    }

    .page {
      min-height: 100vh;
      display: none;
      padding: 30px 18px;
      position: relative;
      overflow: hidden;
    }

    .page.active {
      display: block;
    }

    .center {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .card {
      width: min(92%, 600px);
      padding: 35px 25px;
      background: rgba(255,255,255,0.65);
      border: 2px solid rgba(255,255,255,0.8);
      border-radius: 30px;
      box-shadow: 0 15px 50px rgba(130,60,110,0.18);
      backdrop-filter: blur(12px);
    }

    h1 {
      font-size: clamp(2.3rem, 8vw, 4.5rem);
      margin-bottom: 15px;
    }

    h2 {
      font-size: 2rem;
      margin-bottom: 15px;
    }

    p {
      line-height: 1.7;
      margin: 10px 0;
    }

    .cute {
      font-size: 1.15rem;
    }

    .btn {
      border: none;
      padding: 13px 24px;
      margin: 10px 5px;
      border-radius: 999px;
      background: #ff5f9e;
      color: white;
      font-size: 1rem;
      font-weight: bold;
      box-shadow: 0 8px 20px rgba(255,95,158,0.3);
      transition: .25s;
    }

    .btn:hover {
      transform: translateY(-3px) scale(1.03);
    }

    .btn.secondary {
      background: #9d6cff;
    }

    .input {
      width: 100%;
      max-width: 350px;
      padding: 14px 18px;
      border: 2px solid #ffc0d9;
      border-radius: 999px;
      outline: none;
      text-align: center;
      font-size: 1rem;
      margin: 15px auto;
      display: block;
      background: white;
    }

    .error {
      color: #d33b67;
      min-height: 25px;
      font-weight: bold;
    }

    .top {
      max-width: 1100px;
      margin: auto;
      text-align: center;
    }

    .section {
      max-width: 1000px;
      margin: 25px auto;
      padding: 25px;
      background: rgba(255,255,255,0.55);
      border-radius: 28px;
      backdrop-filter: blur(10px);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 18px;
      margin-top: 20px;
    }

    .box {
      min-height: 170px;
      padding: 25px 18px;
      border-radius: 25px;
      background: rgba(255,255,255,0.75);
      box-shadow: 0 8px 25px rgba(120,60,100,.12);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      transition: .25s;
    }

    .box:hover {
      transform: translateY(-5px);
    }

    .emoji {
      font-size: 3rem;
      margin-bottom: 10px;
    }

    .hidden-content {
      display: none;
      margin-top: 15px;
      padding: 15px;
      border-radius: 18px;
      background: #fff0f7;
    }

    .memory {
      padding: 20px;
      border-radius: 20px;
      background: linear-gradient(135deg,#fff,#ffe7f2);
      min-height: 130px;
    }

    .letter {
      background: #fffafc;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 8px 25px rgba(80,40,60,.12);
      text-align: left;
      font-family: Georgia, serif;
      font-size: 1.05rem;
      line-height: 1.9;
    }

    .quiz-question {
      font-size: 1.2rem;
      font-weight: bold;
      margin: 20px 0;
    }

    .option {
      display: block;
      width: min(90%, 400px);
      margin: 10px auto;
      padding: 12px;
      border: 2px solid #ffc0d9;
      border-radius: 18px;
      background: white;
      color: #63364f;
      transition: .2s;
    }

    .option:hover {
      background: #ffe4f0;
      transform: scale(1.02);
    }

    .score {
      font-size: 1.4rem;
      font-weight: bold;
      margin: 20px;
    }

    .floating {
      position: fixed;
      pointer-events: none;
      animation: floatUp 7s linear forwards;
      z-index: 10;
    }

    @keyframes floatUp {
      from {
        transform: translateY(100vh) rotate(0deg);
        opacity: 0;
      }
      10% { opacity: 1; }
      to {
        transform: translateY(-120vh) rotate(360deg);
        opacity: 0;
      }
    }

    .pulse {
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }

    .small {
      font-size: .9rem;
      opacity: .75;
    }

    footer {
      text-align: center;
      padding: 30px 10px;
      opacity: .7;
    }
  </style>
</head>

<body>

  <!-- HOME -->
  <section id="home" class="page active center">
    <div class="card pulse">
      <div style="font-size:4rem;">🎀</div>

      <h1>Hey Mimi 🎀</h1>

      <p class="cute">
        I made a tiny secret world specially for you...
      </p>

      <p>
        But shhh 🤫<br>
        You have to unlock it first.
      </p>

      <button class="btn" onclick="showPage('lock')">
        Unlock My Surprise 🔐
      </button>
    </div>
  </section>


  <!-- PASSWORD -->
  <section id="lock" class="page center">
    <div class="card">

      <div style="font-size:3rem;">🔐</div>

      <h2>Secret Entry</h2>

      <p>Only the real Mimi can enter 😌🎀</p>

      <input
        id="password"
        class="input"
        type="password"
        placeholder="Enter secret password"
      />

      <button class="btn" onclick="unlock()">
        Enter 💗
      </button>

      <div id="error" class="error"></div>

      <button class="btn secondary" onclick="showPage('home')">
        Go Back
      </button>

    </div>
  </section>


  <!-- MAIN WORLD -->
  <section id="world" class="page">

    <div class="top">

      <div style="font-size:4rem;">🎀✨</div>

      <h1>Welcome, Mimi!</h1>

      <p class="cute">
        You officially entered the Secret Bestie World 💗
      </p>

      <p>
        Now explore everything I secretly made for you 👀
      </p>

    </div>


    <!-- SURPRISE BOXES -->
    <div class="section">

      <h2>🎁 Surprise Boxes</h2>

      <p>Click each one. Don't skip any! 😤</p>

      <div class="grid">

        <div class="box">
          <div class="emoji">💌</div>
          <h3>Secret Letter</h3>

          <button class="btn" onclick="openBox('letterBox')">
            Open
          </button>

          <div id="letterBox" class="hidden-content">
            Dear Mimi 🎀,<br><br>

            You are honestly one of those people who make
            normal days feel a little more special. 🥹💗

            <br><br>

            Thank you for all the random conversations,
            stupid jokes, teasing, and unforgettable moments.

            <br><br>

            Stay the same crazy, cute and amazing person.

            <br><br>

            Your bestie,
            <br>
            Aayush 🫶
          </div>
        </div>


        <div class="box">
          <div class="emoji">😂</div>
          <h3>Funny Message</h3>

          <button class="btn" onclick="openBox('funnyBox')">
            Open
          </button>

          <div id="funnyBox" class="hidden-content">
            Congratulations! 🎉<br><br>
            You have officially been selected as
            my permanent bestie.

            <br><br>

            Unfortunately, there is NO unsubscribe button. 😭😂
          </div>
        </div>


        <div class="box">
          <div class="emoji">🫶</div>
          <h3>Bestie Fact</h3>

          <button class="btn" onclick="openBox('factBox')">
            Open
          </button>

          <div id="factBox" class="hidden-content">
            Fun fact:

            <br><br>

            Somehow we can turn a 5-minute conversation
            into a 2-hour conversation. 😭

            <br><br>

            And honestly... that's the best part.
          </div>
        </div>


        <div class="box">
          <div class="emoji">👀</div>
          <h3>Teasing Message</h3>

          <button class="btn" onclick="openBox('teaseBox')">
            Open
          </button>

          <div id="teaseBox" class="hidden-content">
            Mimi...

            <br><br>

            You're cute.

            <br><br>

            But don't let this compliment get to your head. 😭😂
          </div>
        </div>

      </div>
    </div>


    <!-- QUIZ -->
    <div class="section">

      <h2>🎮 How Well Do You Know Me?</h2>

      <p>
        Let's see if you're actually a certified bestie 😭
      </p>

      <div id="quiz"></div>

      <div id="score" class="score"></div>

    </div>


    <!-- MEMORIES -->
    <div class="section">

      <h2>📸 Our Memory Corner</h2>

      <p>
        Replace these cards with your actual memories later.
      </p>

      <div class="grid">

        <div class="memory">
          <h3>🌸 Memory #1</h3>
          <p>
            That random conversation that somehow became
            a whole story. 😂
          </p>
        </div>

        <div class="memory">
          <h3>🎀 Memory #2</h3>
          <p>
            One of those moments where we laughed
            for absolutely no reason.
          </p>
        </div>

        <div class="memory">
          <h3>✨ Memory #3</h3>
          <p>
            Another memory waiting to be added...
          </p>
        </div>

      </div>

    </div>


    <!-- FINAL MESSAGE -->
    <div class="section">

      <h2>💗 One Last Thing...</h2>

      <div class="letter">

        Mimi,

        <br><br>

        This little website isn't really about the website.

        <br><br>

        It's just my small way of saying that I'm genuinely
        happy you're my bestie.

        <br><br>

        We've had funny moments, random conversations,
        teasing, and probably a lot more nonsense than
        necessary. 😂

        <br><br>

        But those little things are exactly what make
        the friendship special.

        <br><br>

        So yeah...

        <br><br>

        <strong>
          Thanks for being my bestie. 🎀🫶
        </strong>

        <br><br>

        And remember:

        <br>

        <strong>
          You're stuck with me. 😭😂
        </strong>

      </div>

    </div>


    <div style="text-align:center;">

      <button class="btn" onclick="createHearts()">
        Make It Rain Hearts 💗
      </button>

      <button class="btn secondary" onclick="showPage('home')">
        Start Again 🔄
      </button>

    </div>

    <footer>
      Made with 💗 for Mimi 🎀
    </footer>

  </section>


  <script>

    /* PAGE NAVIGATION */

    function showPage(pageId) {

      document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
      });

      document.getElementById(pageId).classList.add("active");

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }


    /* PASSWORD */

    function unlock() {

      const password =
        document.getElementById("password").value.trim();

      const error =
        document.getElementById("error");

      if (password === "MIMI🎀") {

        error.textContent = "";

        showPage("world");

        createHearts();

      } else {

        error.textContent =
          "Hmm... wrong password 👀 Try again!";

      }

    }


    /* ENTER KEY FOR PASSWORD */

    document
      .getElementById("password")
      .addEventListener("keydown", function(event) {

        if (event.key === "Enter") {
          unlock();
        }

      });


    /* SURPRISE BOX */

    function openBox(id) {

      const box =
        document.getElementById(id);

      if (box.style.display === "block") {

        box.style.display = "none";

      } else {

        box.style.display = "block";

        createHearts();

      }

    }


    /* QUIZ */

    const questions = [

      {
        question: "Who is more likely to start a random conversation? 😂",
        options: [
          "Mimi",
          "Aayush",
          "Both",
          "Nobody 😭"
        ],
        answer: 2
      },

      {
        question: "What is the official bestie status?",
        options: [
          "Temporary",
          "Permanent 😤",
          "Trial version",
          "Under maintenance"
        ],
        answer: 1
      },

      {
        question: "What happens if Mimi tries to unsubscribe?",
        options: [
          "It works",
          "Website crashes",
          "There is no unsubscribe button 😂",
          "Bestie deleted"
        ],
        answer: 2
      }

    ];


    let currentQuestion = 0;
    let score = 0;


    function loadQuiz() {

      const quiz =
        document.getElementById("quiz");

      if (currentQuestion >= questions.length) {

        document.getElementById("score").innerHTML =
          `Final Score: ${score}/${questions.length} 🎀<br><br>
           ${getScoreMessage()}`;

        quiz.innerHTML =
          `<button class="btn" onclick="restartQuiz()">
            Play Again 🔄
           </button>`;

        return;
      }


      const q = questions[currentQuestion];

      let html = `
        <div class="quiz-question">
          ${currentQuestion + 1}. ${q.question}
        </div>
      `;


      q.options.forEach((option, index) => {

        html += `
          <button
            class="option"
            onclick="answerQuestion(${index})">
            ${option}
          </button>
        `;

      });


      quiz.innerHTML = html;

    }


    function answerQuestion(index) {

      if (
        index ===
        questions[currentQuestion].answer
      ) {

        score++;

        createHearts();

      }

      currentQuestion++;

      loadQuiz();

    }


    function restartQuiz() {

      currentQuestion = 0;
      score = 0;

      document.getElementById("score").innerHTML = "";

      loadQuiz();

    }


    function getScoreMessage() {

      if (score === questions.length) {
        return "Okayyy! Certified Bestie Status unlocked. 🏆🎀";
      }

      if (score >= 2) {
        return "Not bad! Bestie level: HIGH 😭🫶";
      }

      return "Hmm... bestie training required 😂🎀";

    }


    loadQuiz();


    /* FLOATING HEARTS */

    function createHearts() {

      const emojis = [
        "💗",
        "💕",
        "💖",
        "🎀",
        "✨",
        "🌸",
        "🫶"
      ];

      for (let i = 0; i < 18; i++) {

        const heart =
          document.createElement("div");

        heart.className = "floating";

        heart.textContent =
          emojis[
            Math.floor(
              Math.random() * emojis.length
            )
          ];

        heart.style.left =
          Math.random() * 100 + "vw";

        heart.style.fontSize =
          (18 + Math.random() * 25) + "px";

        heart.style.animationDuration =
          (4 + Math.random() * 5) + "s";

        document.body.appendChild(heart);


        setTimeout(() => {
          heart.remove();
        }, 9000);

      }

    }


    /* BACKGROUND FLOATING DECORATIONS */

    setInterval(() => {

      const emoji =
        document.createElement("div");

      emoji.className = "floating";

      emoji.textContent =
        Math.random() > .5 ? "♡" : "✦";

      emoji.style.left =
        Math.random() * 100 + "vw";

      emoji.style.fontSize = "18px";

      emoji.style.animationDuration =
        (7 + Math.random() * 4) + "s";

      document.body.appendChild(emoji);

      setTimeout(() => {
        emoji.remove();
      }, 12000);

    }, 1800);

  </script>

</body>
                                      </html>
