<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mimi 🎀 | Secret Bestie World</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:"Trebuchet MS",Arial,sans-serif;
  background:linear-gradient(135deg,#ffdbea,#ffeef6,#ffd1e5);
  color:#54233f;
  min-height:100vh;
  overflow-x:hidden;
}

.page{
  display:none;
  min-height:100vh;
  padding:25px 16px;
}

.page.active{
  display:flex;
  justify-content:center;
  align-items:center;
}

.card{
  width:100%;
  max-width:650px;
  background:rgba(255,255,255,.82);
  border:2px solid rgba(255,255,255,.9);
  border-radius:30px;
  padding:28px 20px;
  text-align:center;
  box-shadow:0 15px 45px rgba(120,45,85,.18);
  backdrop-filter:blur(12px);
}

h1{
  font-size:2.5rem;
  margin:12px 0;
}

h2{
  font-size:2rem;
  margin-bottom:12px;
}

p{
  line-height:1.7;
  margin:12px 0;
}

.btn{
  border:0;
  background:#ff4f9a;
  color:white;
  padding:14px 24px;
  border-radius:50px;
  font-size:1rem;
  font-weight:bold;
  cursor:pointer;
  margin:8px;
  box-shadow:0 7px 18px rgba(255,79,154,.3);
}

.btn:active{
  transform:scale(.95);
}

.back{
  background:#d58bb1;
}

.input{
  width:100%;
  padding:14px;
  border:2px solid #ff9ac4;
  border-radius:15px;
  outline:none;
  text-align:center;
  font-size:1rem;
  margin:10px 0;
}

.boxes{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
  margin:20px 0;
}

.box{
  background:#fff0f7;
  border:2px dashed #ff9bc3;
  border-radius:20px;
  padding:24px 8px;
  cursor:pointer;
  transition:.25s;
}

.box:hover{
  transform:translateY(-4px) rotate(-1deg);
}

.message{
  display:none;
  background:#ffe1ed;
  padding:16px;
  border-radius:18px;
  margin:10px 0;
  animation:pop .4s ease;
}

@keyframes pop{
  from{transform:scale(.7);opacity:0}
  to{transform:scale(1);opacity:1}
}

/* Envelope */
.envelope{
  width:230px;
  height:150px;
  margin:25px auto;
  background:#ff9fc5;
  border-radius:12px;
  position:relative;
  cursor:pointer;
  box-shadow:0 10px 25px rgba(100,30,70,.15);
}

.envelope:before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  border-left:115px solid transparent;
  border-right:115px solid transparent;
  border-top:80px solid #ff75ad;
}

.envelope span{
  position:absolute;
  width:100%;
  top:55px;
  left:0;
  font-size:40px;
}

/* Letter */
.letter{
  display:none;
  background:#fffdf5;
  border:2px solid #e8cdb5;
  border-radius:18px;
  padding:22px;
  text-align:left;
  box-shadow:0 8px 20px rgba(80,40,30,.1);
}

#typedText{
  white-space:pre-line;
  line-height:1.8;
}

/* Timeline */
.timeline{
  text-align:left;
  margin-top:20px;
}

.timeline-item{
  background:#fff1f7;
  border-left:5px solid #ff65a5;
  padding:15px;
  margin:12px 0;
  border-radius:0 15px 15px 0;
}

/* Gallery */
.gallery{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
  margin-top:20px;
}

.photo-card{
  background:#fff;
  padding:8px 8px 14px;
  border-radius:10px;
  box-shadow:0 7px 18px rgba(80,30,60,.15);
  transform:rotate(-2deg);
}

.photo-card:nth-child(even){
  transform:rotate(2deg);
}

.photo{
  height:150px;
  background:linear-gradient(135deg,#ffc4dc,#ffe8f2);
  border-radius:7px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:45px;
  overflow:hidden;
}

.photo img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.caption{
  margin-top:9px;
  font-size:.9rem;
}

/* Game */
#gameArea{
  height:300px;
  background:#fff0f7;
  border:2px dashed #ff8fbb;
  border-radius:20px;
  position:relative;
  overflow:hidden;
  margin-top:15px;
}

.heartGame{
  position:absolute;
  font-size:32px;
  cursor:pointer;
  animation:fall 3s linear;
}

@keyframes fall{
  from{top:-40px}
  to{top:320px}
}

/* Music */
.music{
  position:fixed;
  top:12px;
  right:12px;
  z-index:20;
}

.music button{
  border:0;
  background:#ff4f9a;
  color:white;
  border-radius:50px;
  padding:10px 15px;
  cursor:pointer;
}

/* Floating */
.float{
  position:fixed;
  bottom:-30px;
  pointer-events:none;
  animation:floatUp 5s linear forwards;
  z-index:50;
}

@keyframes floatUp{
  to{
    transform:translateY(-110vh) rotate(360deg);
    opacity:0;
  }
}

/* Confetti */
.confetti{
  position:fixed;
  top:-20px;
  font-size:24px;
  z-index:100;
  animation:confetti 3s linear forwards;
}

@keyframes confetti{
  to{
    transform:translateY(110vh) rotate(720deg);
    opacity:0;
  }
}

.small{
  opacity:.7;
  font-size:.9rem;
}

@media(max-width:500px){
  h1{font-size:2rem}
  .gallery{grid-template-columns:1fr 1fr}
  .photo{height:120px}
}
</style>
</head>

<body>

<!-- MUSIC BUTTON -->
